{
  "$id": "people",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["login", "id", "type", "role"],
    "properties": {
      "login": { "type": "string", "minLength": 1 },
      "id": { "type": "integer", "minimum": 1 },
      "type": { "enum": ["User", "Bot"] },
      "appIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "integer", "minimum": 1 }
      },
      "role": {
        "enum": ["owner", "orchestrator", "worker", "collaborator", "system"]
      },
      "repos": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
        }
      },
      "events": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["check_run", "status", "workflow_run"] }
      }
    },
    "allOf": [
      {
        "if": { "properties": { "repos": {} }, "required": ["repos"] },
        "then": { "properties": { "role": { "const": "orchestrator" } } }
      },
      {
        "if": { "properties": { "role": { "const": "system" } } },
        "then": {
          "properties": { "appIds": {}, "events": {} },
          "required": ["appIds", "events"]
        }
      }
    ]
  }
}
