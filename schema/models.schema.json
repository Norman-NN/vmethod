{
  "$id": "models",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["family", "model", "kind", "gate", "tier"],
    "properties": {
      "family": { "type": "string" },
      "model": { "type": "string", "minLength": 1 },
      "price": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "output", "cached"],
        "properties": {
          "input": { "type": "number", "minimum": 0 },
          "output": { "type": "number", "minimum": 0 },
          "cached": { "type": "number", "minimum": 0 }
        }
      },
      "kind": { "enum": ["opencode", "claude"] },
      "gate": { "enum": ["none", "owner"] },
      "fallback": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "tier": { "enum": ["expensive", "standard", "cheap"] }
    },
    "if": { "properties": { "kind": { "const": "opencode" } } },
    "then": {
      "properties": {
        "model": { "type": "string", "pattern": "^[^/\\s]+/[^\\s]+$" }
      }
    },
    "else": {
      "properties": { "model": { "type": "string", "pattern": "^[^/\\s]+$" } }
    }
  }
}
